# Copy to .env and edit. NEVER commit .env - it is in .gitignore.
# Muraqib runs fully with none of this set: the default provider is the
# deterministic offline engine, which needs no key, no network and no money.

# ---- Model provider ----
# offline | anthropic | openai | azure_openai | groq | gemini | ollama
MURAQIB_PROVIDER=offline
MURAQIB_MODEL=offline-deterministic
# MURAQIB_PROVIDER=anthropic
# MURAQIB_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# Free options that cost nothing:
#   Ollama (fully local, nothing leaves the machine - the sovereign-hosting shape):
#     MURAQIB_PROVIDER=ollama
#     MURAQIB_MODEL=llama3.1:8b
#   Groq / Gemini free tiers:
#     MURAQIB_PROVIDER=groq   MURAQIB_BASE_URL=https://api.groq.com/openai/v1   GROQ_API_KEY=
#     MURAQIB_PROVIDER=gemini MURAQIB_MODEL=gemini-2.0-flash                    GEMINI_API_KEY=

# ---- Run budgets (hard ceilings, enforced per run) ----
MURAQIB_MAX_CALLS=400
MURAQIB_MAX_COST_USD=2.0
MURAQIB_MAX_RETRIES=3

# ---- Retrieval ----
MURAQIB_EMBEDDING_BACKEND=auto      # auto | sentence-transformers | hashing
MURAQIB_VECTOR_BACKEND=memory       # memory | chroma | pgvector
MURAQIB_TOP_K=6
MURAQIB_HYBRID_ALPHA=0.6

# ---- Guardrails (leave these on) ----
MURAQIB_REDACT_PII=1
MURAQIB_BLOCK_INJECTION=1
MURAQIB_REQUIRE_CITATIONS=1
MURAQIB_ENABLE_CRITIC=1

# ---- API auth: OAuth 2.1 / OIDC ----
MURAQIB_AUTH_ENABLED=0
# Microsoft Entra ID example:
# MURAQIB_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# MURAQIB_OIDC_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# MURAQIB_OIDC_AUDIENCE=api://<application-id>
# Local development only - HS256 with a shared secret. Never in production.
# MURAQIB_DEV_HS256_SECRET=

# ---- Observability ----
MURAQIB_LOG_LEVEL=INFO
MURAQIB_OTEL_ENABLED=0
